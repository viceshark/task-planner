# Скопируйте в .env и поменяйте значения

# Логин и пароль для входа в приложение
APP_USERNAME=admin
APP_PASSWORD=change-me

# Создать демо-сотрудников при пустой базе
APP_SEED_EMPLOYEES=true

# Адрес сайта для Caddy.
# Домен (с A-записью на этот сервер) — автоматический HTTPS:
DOMAIN=task-planeur.vc-inc.tech
# Для локальной работы без сертификата:
# DOMAIN=http://localhost
